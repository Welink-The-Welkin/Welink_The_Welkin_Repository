# 当前活动模型：本机 LM Studio / OpenAI 兼容接口
WANDERER_DEMO_MODE=live
WANDERER_MODEL_API_KEY=replace-with-your-provider-api-key
WANDERER_MODEL_BASE_URL=https://api.example.com/v1
WANDERER_MODEL_ENDPOINT=
WANDERER_MODEL_NAME=your-model-name
WANDERER_MODEL_TIMEOUT=60
# ======== 远程中转站模型 (多供应商模式) ========
PROVIDER_remote_gpt_PROTOCOL=openai_compatible
PROVIDER_remote_gpt_BASE_URL=https://api.example.com/v1
PROVIDER_remote_gpt_MODEL=your-model-name
PROVIDER_remote_gpt_CREDENTIAL_ENV=REMOTE_GPT_API_KEY
REMOTE_GPT56_API_KEY=replace-with-your-provider-api-key
# ======== 本地模型 (LM Studio) ========
PROVIDER_local_bionic_PROTOCOL=openai_compatible
PROVIDER_local_bionic_BASE_URL=http://localhost:1235/v1  # 注意看你的端口是1235还是1234
PROVIDER_local_bionic_MODEL=your-model-name
PROVIDER_local_bionic_CREDENTIAL_ENV=LOCAL_BIONIC_API_KEY
LOCAL_BIONIC_API_KEY=local
# ======== 可选：GPT-SoVITS v2Pro 角色语音 ========
# 启用后，start.ps1 会在本机后台启动 GPT-SoVITS；auto 会检测可用 CUDA，无法使用时回退 CPU。
WANDERER_TTS_ENABLED=false
GPT_SOVITS_ROOT=C:\path\to\GPT-SoVITS-v2pro-20250604
WANDERER_TTS_DEVICE=auto
WANDERER_TTS_API_URL=http://127.0.0.1:9880/tts
WANDERER_TTS_REFERENCE_AUDIO=logs/wanderer/5-wav32k/6.1流浪者全语音无音效无背景音乐（自用）.mp3_0000716160_0000856960.wav
WANDERER_TTS_PROMPT_TEXT=可别让我失望.这世上没有纯粹的自由.
# 默认采用更稳定、略慢的发音参数；修改后会自动使用独立的新语音缓存。
WANDERER_TTS_TOP_K=5
WANDERER_TTS_TOP_P=0.8
WANDERER_TTS_TEMPERATURE=0.7
WANDERER_TTS_SPEED_FACTOR=0.9
WANDERER_TTS_SEED=1234
WANDERER_TTS_PARALLEL_INFER=false
# 可选：使用本项目本地训练出的增强候选权重。候选文件位于 data/voice-training/...，
# 只有在试听确认音质合适后才取消注释；留空时使用 GPT_weights_v2Pro\流浪者-e15.ckpt。
# WANDERER_TTS_GPT_WEIGHTS=C:\path\to\wanderer-game\data\voice-training\wanderer-augmented-20261024\candidate\weights\wanderer_augmented-e4.ckpt
WANDERER_TTS_TIMEOUT=240
WANDERER_TTS_STARTUP_TIMEOUT=300
