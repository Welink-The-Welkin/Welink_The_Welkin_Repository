# Copy settings into a private environment; empty entries are placeholders.
# Choose offline or live explicitly for WANDERER_DEMO_MODE.
WANDERER_DEMO_MODE=
WANDERER_MODEL_API_KEY=
WANDERER_MODEL_BASE_URL=
WANDERER_MODEL_ENDPOINT=
WANDERER_MODEL_NAME=
WANDERER_MODEL_TIMEOUT=

# Optional provider configuration; credentials stay on the server.
PROVIDER_remote_gpt_PROTOCOL=
PROVIDER_remote_gpt_BASE_URL=
PROVIDER_remote_gpt_MODEL=
PROVIDER_remote_gpt_CREDENTIAL_ENV=
REMOTE_GPT_API_KEY=
PROVIDER_local_bionic_PROTOCOL=
PROVIDER_local_bionic_BASE_URL=
PROVIDER_local_bionic_MODEL=
PROVIDER_local_bionic_CREDENTIAL_ENV=
LOCAL_BIONIC_API_KEY=

# Optional character voice: set WANDERER_TTS_ENABLED=true only after configuring.
# Local mode uses loopback HTTP and an existing local GPT-SoVITS installation.
# Remote mode uses an independent HTTPS /tts endpoint; no workstation is needed.
# WANDERER_TTS_API_URL=https://voice-service.invalid/tts
# Reference paths and transcript belong to the TTS host, not to the browser.
WANDERER_TTS_ENABLED=
WANDERER_TTS_API_URL=
WANDERER_TTS_REFERENCE_AUDIO=
WANDERER_TTS_PROMPT_TEXT=
WANDERER_TTS_TIMEOUT=
WANDERER_TTS_CACHE_DIR=

# Local launcher settings; remote deployments do not need these assets.
GPT_SOVITS_ROOT=
WANDERER_TTS_DEVICE=
WANDERER_TTS_GPT_WEIGHTS=
WANDERER_TTS_SOVITS_WEIGHTS=
WANDERER_TTS_STARTUP_TIMEOUT=

# Optional articulation overrides; leave unset to use application defaults.
WANDERER_TTS_TOP_K=
WANDERER_TTS_TOP_P=
WANDERER_TTS_TEMPERATURE=
WANDERER_TTS_SPEED_FACTOR=
WANDERER_TTS_SEED=
WANDERER_TTS_PARALLEL_INFER=
