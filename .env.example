# Offline play works without a model API.
WANDERER_DEMO_MODE=offline
WANDERER_MODEL_API_KEY=
WANDERER_MODEL_BASE_URL=https://api.example.com/v1
WANDERER_MODEL_ENDPOINT=
WANDERER_MODEL_NAME=your-model-name
WANDERER_MODEL_TIMEOUT=60

# Optional local GPT-SoVITS. Model weights and reference audio are not included.
WANDERER_TTS_ENABLED=false
GPT_SOVITS_ROOT=C:\path\to\your\GPT-SoVITS
WANDERER_TTS_DEVICE=auto
WANDERER_TTS_API_URL=http://127.0.0.1:9880/tts
WANDERER_TTS_REFERENCE_AUDIO=path/to/your/reference.wav
WANDERER_TTS_PROMPT_TEXT=text matching your reference audio
WANDERER_TTS_GPT_WEIGHTS=path/to/your/checkpoint.ckpt
WANDERER_TTS_SOVITS_WEIGHTS=path/to/your/sovits-model.pth
WANDERER_TTS_TOP_K=5
WANDERER_TTS_TOP_P=0.8
WANDERER_TTS_TEMPERATURE=0.7
WANDERER_TTS_SPEED_FACTOR=0.9
WANDERER_TTS_SEED=1234
WANDERER_TTS_PARALLEL_INFER=false
WANDERER_TTS_TIMEOUT=240
WANDERER_TTS_STARTUP_TIMEOUT=300
